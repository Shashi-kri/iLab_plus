# Example environment variables for iLab+ Application

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=False

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# ML Model Paths
MODEL_PATH=ml_models/Eye-Disease-Prediction/eye_disease_classifier.keras
BACKUP_MODEL_PATH=ml_models/Eye-Disease-Prediction/best_eye_model.keras

# CORS Settings
ALLOWED_ORIGINS=*

# TensorFlow Configuration
TF_CPP_MIN_LOG_LEVEL=2

# Database (if needed in future)
# DATABASE_URL=sqlite:///ilab_plus.db

# API Keys (if integrating external services)
# OPENAI_API_KEY=your-api-key
# GEMINI_API_KEY=your-api-key

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
